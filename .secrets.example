CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AI_API_KEY=
AXIOM_API_TOKEN=

# Android signing
SVERTO_STORE_FILE=
SVERTO_STORE_PASSWORD=
SVERTO_KEY_ALIAS=sverto
SVERTO_KEY_PASSWORD=

# TrueLayer connector (optional)
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_ENV=sandbox
# Comma-separated allowed redirect URIs. TrueLayer requires https and each must be
# registered in the TrueLayer console. The Android app posts <API_BASE_URL>/connectors/
# truelayer/callback (a public backend bounce page that forwards into the app via the
# sverto:// deep link); the web app posts <ORIGIN>/settings/connectors/truelayer/callback.
# Prod example: https://api.sverto.com/connectors/truelayer/callback,https://app.sverto.com/settings/connectors/truelayer/callback
TRUELAYER_REDIRECT_URI_ALLOWLIST=http://localhost:20002/connectors/truelayer/callback,http://localhost:20003/settings/connectors/truelayer/callback

# Enable Banking connector (optional)
ENABLEBANKING_APPLICATION_ID=
# Enable Banking private key. May be an inline PEM (single line with \n escapes, or with real
# line breaks), or a path to a .pem file. 
ENABLEBANKING_PRIVATE_KEY=
# Comma-separated allowed redirect URIs. Enable Banking requires https and each must be
# registered in the Enable Banking dashboard. The Android app posts <API_BASE_URL>/connectors/
# enablebanking/callback (a public backend bounce page that forwards into the app via the
# sverto:// deep link); the web app posts <ORIGIN>/settings/connectors/enablebanking/callback.
# Prod example: https://api.sverto.com/connectors/enablebanking/callback,https://app.sverto.com/settings/connectors/enablebanking/callback
ENABLEBANKING_REDIRECT_URI_ALLOWLIST=
